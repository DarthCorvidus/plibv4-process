{
	"minimum-stability": "dev",
	"prefer-stable": true,
	"name": "plibv4/process",
	"autoload": {
        "classmap": ["src/"]
    },
	"require-dev": {
		"vimeo/psalm": "^6",
		"phpunit/phpunit": "^9"
	},
	"scripts": {
		"test": "./vendor/bin/phpunit --bootstrap tests/autoload.php tests",
		"testdox": "./vendor/bin/phpunit --bootstrap tests/autoload.php --testdox --colors=always tests",
		"coverage": "phpdbg -qrr ./vendor/bin/phpunit --bootstrap tests/autoload.php tests --coverage-text",
		"coverage-html": "phpdbg -qrr ./vendor/bin/phpunit --bootstrap tests/autoload.php tests --coverage-html coverage",
		"psalm": "./vendor/bin/psalm --show-info=true --no-cache"
	}
}
